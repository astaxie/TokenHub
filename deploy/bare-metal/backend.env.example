# TokenHub backend configuration for the bare-metal (systemd) deployment.
# Installed to /etc/tokenhub/backend.env, mode 0640, root:tokenhub.
#
# This is a systemd EnvironmentFile, NOT a shell script and NOT a Compose .env:
#   * no ${VAR} interpolation - write every value literally
#   * no command substitution, no export, no inline comments after a value
#   * quote values containing spaces: TOKENHUB_X="a b"
#   * a literal $ needs no escaping, but a value must stay on one line

TOKENHUB_ENV=prod
TOKENHUB_HTTP_ADDR=:8080
TOKENHUB_LOG_LEVEL=info

# Public base URL of the API itself (used for links and OAuth redirects).
TOKENHUB_PUBLIC_BASE_URL=http://localhost:8080

# The admin console runs in the browser and calls this API directly, so the
# origin below must be exactly what the browser shows for the console:
# scheme + host + port, no trailing path. Multiple origins are comma-separated.
TOKENHUB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated CIDRs of reverse proxies allowed to set forwarded headers.
# Leave empty when nothing sits in front of the backend.
TOKENHUB_TRUSTED_PROXY_CIDRS=

# --- Secrets ------------------------------------------------------------------
# install.sh --generate-secrets fills these with openssl-generated values.
# The backend refuses to start in prod while the change-me placeholders remain.
# Keep TOKENHUB_SECRET_KEY safe and backed up: it decrypts stored provider
# credentials, so a database backup is useless without it.
TOKENHUB_SECRET_KEY=change-me-tokenhub-secret-key
TOKENHUB_ADMIN_TOKEN=change-me-tokenhub-admin-token
TOKENHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-tokenhub-admin-password

# --- Database -----------------------------------------------------------------
# SQLite only. Absolute paths on purpose: the built-in defaults are relative to
# the working directory, which here is the read-only release directory.
TOKENHUB_DATABASE_URL=sqlite:///var/lib/tokenhub/tokenhub.db
TOKENHUB_SQLITE_BACKUP_DIR=/var/lib/tokenhub/backups

# The backend also speaks PostgreSQL, but this installer does not manage it: it
# would have to own the preflight checks, the pre-upgrade dump and the backup
# timer as well. Setting TOKENHUB_DB_HOST or a postgres:// URL here is rejected
# rather than half-supported. To run on PostgreSQL, deploy the backend yourself
# and see docs/postgresql-setup.md.

# --- Catalogs -----------------------------------------------------------------
TOKENHUB_MODEL_CATALOG_FILE=/opt/tokenhub/current/catalog/model-catalog.yaml
TOKENHUB_PROVIDER_CATALOG_FILE=/opt/tokenhub/current/catalog/provider-catalog.json

# --- Routing and resiliency ---------------------------------------------------
TOKENHUB_SEED_DEMO=false
TOKENHUB_RESOURCE_FAILURE_THRESHOLD=3
TOKENHUB_RESOURCE_COOLDOWN_SECONDS=300
TOKENHUB_RESOURCE_COOLDOWN_MAX_SECONDS=3600
TOKENHUB_IN_FLIGHT_LEASE_TTL_SECONDS=300
TOKENHUB_CLUSTER_LOCK_TTL_SECONDS=180
# Must stay below TimeoutStopSec in tokenhub-backend.service (180s), otherwise
# systemd kills the process before it finishes draining in-flight requests.
TOKENHUB_GRACEFUL_SHUTDOWN_SECONDS=150

# --- Cache locality routing ---------------------------------------------------
TOKENHUB_CACHE_AFFINITY_ENABLED=false
TOKENHUB_CACHE_AFFINITY_MODELS=
TOKENHUB_CACHE_AFFINITY_ALLOW_USER_SCOPE=false

# --- Metrics ------------------------------------------------------------------
TOKENHUB_METRICS_ENABLED=false
# Leave empty to accept the admin token; set a dedicated value to keep the admin
# credential out of your Prometheus scrape config.
TOKENHUB_METRICS_TOKEN=
TOKENHUB_METRICS_PROJECT_LABEL=false

# --- Backup timer -------------------------------------------------------------
# Days before a SQLite backup created by tokenhub-backup.timer is eligible for
# deletion by the same timer's retention pass.
TOKENHUB_BACKUP_EXPIRE_DAYS=14
