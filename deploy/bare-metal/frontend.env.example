# TokenHub admin console configuration for the bare-metal (systemd) deployment.
# Installed to /etc/tokenhub/frontend.env, mode 0640, root:tokenhub-web.
#
# This file deliberately holds no secrets. The console runs as its own user and
# never receives TOKENHUB_SECRET_KEY, the admin token or database credentials.
#
# systemd EnvironmentFile syntax: no ${VAR} interpolation, one value per line.

# Where the browser reaches the backend API.
#
# This value is rendered into the page and used by the browser, not by the Node
# process, so it must be resolvable from the operator's machine. http://127.0.0.1
# only works when the console is opened on the server itself.
#
# Two further traps:
#   * a console served over HTTPS cannot call an HTTP API (mixed content);
#   * the admin session caches this URL in the browser's local storage, so
#     changing it here does not affect an existing session until the user logs
#     out or clears site data.
TOKENHUB_API_BASE_URL=http://localhost:8080

# Listen address of the console itself.
HOSTNAME=0.0.0.0
PORT=3000
