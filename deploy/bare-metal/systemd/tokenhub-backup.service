[Unit]
Description=TokenHub SQLite backup and retention
Documentation=https://github.com/astaxie/TokenHub
After=tokenhub-backend.service

[Service]
Type=oneshot
User=tokenhub
Group=tokenhub
# Provides TOKENHUB_ADMIN_TOKEN, TOKENHUB_HTTP_ADDR and TOKENHUB_SQLITE_BACKUP_DIR.
EnvironmentFile=/etc/tokenhub/backend.env
WorkingDirectory=/opt/tokenhub/current
# Backups are taken through the backend's online-backup API rather than by copying
# a live database file; the retention pass then deletes expired backups so their
# database records disappear together with the files.
ExecStart=/usr/bin/env node /opt/tokenhub/current/scripts/backup-sqlite.mjs
StateDirectory=tokenhub
StateDirectoryMode=0750
UMask=0077
# A backup of a large database can outlive systemd's default start timeout, which
# would kill the run partway through.
TimeoutStartSec=3600

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
