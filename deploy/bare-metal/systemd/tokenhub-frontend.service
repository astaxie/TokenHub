[Unit]
Description=TokenHub admin console (Next.js standalone server)
Documentation=https://github.com/astaxie/TokenHub
After=network-online.target
Wants=network-online.target

[Service]
User=tokenhub-web
Group=tokenhub-web
# Deliberately NOT the backend env file: the console never needs the secret key,
# the admin token or database credentials.
EnvironmentFile=/etc/tokenhub/frontend.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/tokenhub/current/web
# ProtectHome=true below makes a Node installed under a user's home (nvm, asdf)
# unreachable. install.sh verifies the interpreter and writes a drop-in with an
# absolute path when node is outside systemd's default PATH.
ExecStart=/usr/bin/env node /opt/tokenhub/current/web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
