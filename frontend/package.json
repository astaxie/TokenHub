{
  "name": "tokenhub-admin",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check:lines": "node ../tools/check-source-lines.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:domain && npm run test:components",
    "test:domain": "node --test features/admin/domain/*.test.mjs",
    "test:components": "vitest run",
    "test:e2e": "node e2e/run-playwright.mjs",
    "typecheck": "npm run check:lines && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.17.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-select": "5.10.2",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
