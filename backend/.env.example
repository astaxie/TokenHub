TOKENHUB_ENV=dev
TOKENHUB_HTTP_ADDR=:8080
TOKENHUB_PUBLIC_BASE_URL=http://localhost:8080
TOKENHUB_TRUSTED_PROXY_CIDRS=
TOKENHUB_CORS_ALLOWED_ORIGINS=http://localhost:3000
TOKENHUB_ADMIN_TOKEN=dev_admin_token
TOKENHUB_BOOTSTRAP_ADMIN_PASSWORD=admin123456
TOKENHUB_SECRET_KEY=dev_tokenhub_secret_key
TOKENHUB_IN_FLIGHT_LEASE_TTL_SECONDS=300
TOKENHUB_CLUSTER_LOCK_TTL_SECONDS=180
TOKENHUB_GRACEFUL_SHUTDOWN_SECONDS=150

# Database configuration
# SQLite (default)
TOKENHUB_DATABASE_URL=sqlite://data/tokenhub.db
# PostgreSQL example:
# TOKENHUB_DATABASE_URL=postgres://user:password@localhost:5432/tokenhub?sslmode=disable

# Alternative to TOKENHUB_DATABASE_URL: setting TOKENHUB_DB_HOST builds the DSN from
# the separate fields below, so a password containing #, ?, / or % needs no URL
# encoding. TOKENHUB_DATABASE_URL still wins when both are set.
# TOKENHUB_DB_HOST=localhost
# TOKENHUB_DB_PORT=5432
# TOKENHUB_DB_USER=tokenhub
# TOKENHUB_DB_PASSWORD=
# TOKENHUB_DB_NAME=tokenhub
# TOKENHUB_DB_SSLMODE=disable

TOKENHUB_SQLITE_BACKUP_DIR=data/backups

# PostgreSQL connection pool configuration (only applies to PostgreSQL, ignored for SQLite)
TOKENHUB_DB_MAX_OPEN_CONNS=25
TOKENHUB_DB_MAX_IDLE_CONNS=5
TOKENHUB_DB_CONN_MAX_LIFETIME_MINUTES=30

TOKENHUB_MODEL_CATALOG_FILE=../data/model-catalog.yaml
TOKENHUB_PROVIDER_CATALOG_FILE=../data/provider-catalog.json
TOKENHUB_SEED_DEMO=false

# Provider resource breaker. A resource that reaches the failure threshold is parked
# for the base cooldown, then admitted back for one half-open trial request. Repeated
# recovery failures double the window, up to the maximum.
TOKENHUB_RESOURCE_FAILURE_THRESHOLD=3
TOKENHUB_RESOURCE_COOLDOWN_SECONDS=300
TOKENHUB_RESOURCE_COOLDOWN_MAX_SECONDS=3600

# Prometheus metrics. Off by default: /metrics discloses internal topology and spend,
# so exposing it is an explicit operator decision.
TOKENHUB_METRICS_ENABLED=false
# Leave empty to accept the admin token; set a dedicated value to keep the
# highest-privilege credential out of your scrape config.
TOKENHUB_METRICS_TOKEN=
# Adds project_id to every gateway metric, multiplying series count by the project
# count. Off by default.
TOKENHUB_METRICS_PROJECT_LABEL=false

# Cache locality routing: pins a session to one upstream account so the provider's
# prompt cache keeps hitting. Off by default because it changes routing behaviour;
# roll back by turning it off rather than by rolling back the binary.
TOKENHUB_CACHE_AFFINITY_ENABLED=false
# Comma-separated model allowlist for staged rollout. Empty means every model.
TOKENHUB_CACHE_AFFINITY_MODELS=
# Accept user-scoped identifiers (OpenAI `user`, plain Anthropic `metadata.user_id`)
# as affinity keys. Off by default: one user's concurrent sessions share the value,
# so all of that user's traffic would land on a single account.
TOKENHUB_CACHE_AFFINITY_ALLOW_USER_SCOPE=false
