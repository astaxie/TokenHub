TOKENHUB_ENV=dev
TOKENHUB_HTTP_ADDR=:8080
TOKENHUB_PUBLIC_BASE_URL=http://localhost:8080
TOKENHUB_RELEASE_REPOSITORY=astaxie/TokenHub
# Overrides the deployment type compiled into the binary: source, container or native.
# A local `go build` reports source, which offers no managed update.
# TOKENHUB_DEPLOYMENT_TYPE=
TOKENHUB_MANAGED_UPDATES=false
TOKENHUB_INSTALL_ROOT=/opt/tokenhub
TOKENHUB_TRUSTED_PROXY_CIDRS=
TOKENHUB_PROVIDER_UPSTREAM_ALLOWED_CIDRS=
TOKENHUB_CORS_ALLOWED_ORIGINS=http://localhost:3000
TOKENHUB_ADMIN_TOKEN=dev_admin_token
TOKENHUB_BOOTSTRAP_ADMIN_PASSWORD=admin123456
TOKENHUB_SECRET_KEY=dev_tokenhub_secret_key
# Upstream request timeouts. Streaming and non-streaming calls need different
# policies: a total deadline covers reading the response body, so one that suits a
# normal request truncates an SSE stream that is still delivering data.
# Total time limit for one non-streaming upstream request.
TOKENHUB_UPSTREAM_NON_STREAM_TIMEOUT_SECONDS=120
# Streaming calls have no total limit. This bounds how long one may wait for
# response headers, and how long its stream may then stay silent. The budget
# restarts on every byte received, so a stream lives as long as the upstream keeps
# producing. Raise it for long reasoning or coding responses.
TOKENHUB_UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=300

TOKENHUB_IN_FLIGHT_LEASE_TTL_SECONDS=300
TOKENHUB_CLUSTER_LOCK_TTL_SECONDS=180
TOKENHUB_GRACEFUL_SHUTDOWN_SECONDS=150
TOKENHUB_IMAGE_STORAGE_DIR=data/images
TOKENHUB_IMAGE_WORKER_CONCURRENCY=2
TOKENHUB_IMAGE_QUEUE_CAPACITY=64
TOKENHUB_IMAGE_JOB_TIMEOUT_SECONDS=300
TOKENHUB_IMAGE_CAPABILITY_RETRY_SECONDS=86400

# Database configuration
# SQLite (default)
TOKENHUB_DATABASE_URL=sqlite://data/tokenhub.db
# PostgreSQL example:
# TOKENHUB_DATABASE_URL=postgres://user:password@localhost:5432/tokenhub?sslmode=disable

# Alternative to TOKENHUB_DATABASE_URL: setting TOKENHUB_DB_HOST builds the DSN from
# the separate fields below, so a password containing #, ?, / or % needs no URL
# encoding. TOKENHUB_DATABASE_URL still wins when both are set.
# TOKENHUB_DB_HOST=localhost
# TOKENHUB_DB_PORT=5432
# TOKENHUB_DB_USER=tokenhub
# TOKENHUB_DB_PASSWORD=
# TOKENHUB_DB_NAME=tokenhub
# TOKENHUB_DB_SSLMODE=disable

TOKENHUB_SQLITE_BACKUP_DIR=data/backups

# PostgreSQL connection pool configuration (only applies to PostgreSQL, ignored for SQLite)
TOKENHUB_DB_MAX_OPEN_CONNS=25
TOKENHUB_DB_MAX_IDLE_CONNS=5
TOKENHUB_DB_CONN_MAX_LIFETIME_MINUTES=30

TOKENHUB_MODEL_CATALOG_FILE=../data/model-catalog.yaml
TOKENHUB_PROVIDER_CATALOG_FILE=../data/provider-catalog.json
TOKENHUB_SEED_DEMO=false

# Provider resource breaker. A resource that reaches the failure threshold is parked
# for the base cooldown, then admitted back for one half-open trial request. Repeated
# recovery failures double the window, up to the maximum.
TOKENHUB_RESOURCE_FAILURE_THRESHOLD=3
TOKENHUB_RESOURCE_COOLDOWN_SECONDS=300
TOKENHUB_RESOURCE_COOLDOWN_MAX_SECONDS=3600

# Prometheus metrics. Off by default: /metrics discloses internal topology and spend,
# so exposing it is an explicit operator decision.
TOKENHUB_METRICS_ENABLED=false
# Leave empty to accept the admin token; set a dedicated value to keep the
# highest-privilege credential out of your scrape config.
TOKENHUB_METRICS_TOKEN=
# Adds project_id to every gateway metric, multiplying series count by the project
# count. Off by default.
TOKENHUB_METRICS_PROJECT_LABEL=false

# OpenTelemetry trace export. One trace per gateway call: a root span for the request
# and a generation span for every candidate that entered the invocation path, so
# failover, per-candidate tokens and per-candidate cost are visible. Off by default
# because it sends operational data to another system.
TOKENHUB_TRACING_ENABLED=false
# The signal-specific OTLP traces URL, used verbatim. For Langfuse this is
# <host>/api/public/otel/v1/traces. Any OTLP/HTTP backend works.
TOKENHUB_TRACING_ENDPOINT=
# Comma-separated name=value pairs. For Langfuse:
#   Authorization=Basic <base64 of "pk-lf-...:sk-lf-...">,x-langfuse-ingestion-version=4
# Holds a credential: keep it out of version control and out of logs.
TOKENHUB_TRACING_HEADERS=
# Adds prompts, responses and upstream error text to the exported spans. A separate
# decision from turning tracing on, and off by default: without it a trace still
# carries status, latency, routing, tokens and cost.
TOKENHUB_TRACING_CAPTURE_PAYLOADS=false
# Fraction of calls exported, from 0 to 1.
TOKENHUB_TRACING_SAMPLE_RATIO=1
# Time limit for one export attempt.
TOKENHUB_TRACING_TIMEOUT_SECONDS=10
# Completions waiting to become spans. A full queue drops traces rather than slowing
# requests down; the drops are counted in tokenhub_gateway_trace_completions_total.
TOKENHUB_TRACING_QUEUE_SIZE=2048

# Cache locality routing for Chat Completions, Anthropic Messages, and Responses:
# pins a session to one upstream account so the provider's prompt cache keeps hitting.
# Off by default because it changes routing behaviour;
# roll back by turning it off rather than by rolling back the binary.
TOKENHUB_CACHE_AFFINITY_ENABLED=false
# Comma-separated model allowlist for staged rollout. Empty means every model.
TOKENHUB_CACHE_AFFINITY_MODELS=
# Accept user-scoped identifiers (OpenAI/Responses `user`, plain Anthropic `metadata.user_id`)
# as affinity keys. Off by default: one user's concurrent sessions share the value,
# so all of that user's traffic would land on a single account.
TOKENHUB_CACHE_AFFINITY_ALLOW_USER_SCOPE=false

# Target TokenHub Admin API for the tokenhub-migrate CLI (e.g. http://localhost:8080).
# Read only by the migration CLI, never by the running server: set it in the shell
# that runs a migration, not in the server's environment. Overridden by --to.
TOKENHUB_API=
