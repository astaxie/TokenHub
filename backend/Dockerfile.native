FROM golang:1.26-alpine AS builder

WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ARG TOKENHUB_VERSION
ENV GOPROXY=$GOPROXY
RUN apk add --no-cache gcc musl-dev
COPY backend/go.mod ./backend/go.mod
COPY backend/go.sum ./backend/go.sum
COPY backend/cmd ./backend/cmd
COPY backend/internal ./backend/internal
RUN test -n "$TOKENHUB_VERSION" && \
    cd backend && \
    CGO_ENABLED=1 go build \
      -tags "netgo osusergo" \
      -trimpath \
      -ldflags="-s -w -linkmode external -extldflags '-static' -X main.buildVersion=${TOKENHUB_VERSION} -X main.buildType=release -X main.deploymentType=native" \
      -o /out/tokenhub ./cmd/tokenhub

FROM scratch AS artifact
COPY --from=builder /out/tokenhub /tokenhub
